# Google Gemini API Key(s) - Supports comma-separated keys for automatic rotation and failover
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3
GITHUB_TOKEN=optional_personal_access_token
DATABASE_URL=sqlite:///./reviews.db

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Clerk Authentication (From https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
